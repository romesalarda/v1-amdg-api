# =============================================================================
# CORE DJANGO SETTINGS
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
ENVIRONMENT=development

# =============================================================================
# AWS SSM PARAMETER STORE (Production Only)
# =============================================================================
# Set USE_SSM=True in production to load secrets from AWS SSM Parameter Store
USE_SSM=False
SSM_PARAM_PREFIX=/prod/amdg/v1/
AWS_REGION=eu-west-2

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Set USE_POSTGRES=False to use SQLite for local development
USE_POSTGRES=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=amdg_db
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=db
DB_PORT=5432

# =============================================================================
# AWS S3 STORAGE
# =============================================================================
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-west-2

# =============================================================================
# REDIS & CELERY
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_LAYERS_HOST=redis:6379

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# For development: django.core.mail.backends.console.EmailBackend
# For production (SES): django_ses.SESBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@rsalarda.works
SERVER_EMAIL=noreply@rsalarda.works

# AWS SES (Production)
AWS_SES_REGION_NAME=eu-west-2

# SMTP (Alternative/Development)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================
STRIPE_TEST_MODE=True
STRIPE_SECRET_KEY_TEST=sk_test_your-test-key
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_your-test-key
STRIPE_SECRET_KEY_LIVE=sk_live_your-live-key
STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_your-live-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# =============================================================================
# GOOGLE OAUTH (For future implementation)
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# =============================================================================
# SENTRY MONITORING (Optional)
# =============================================================================
SENTRY_ENABLED=False
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
ECR_REGISTRY=123456789012.dkr.ecr.eu-west-2.amazonaws.com
IMAGE_TAG=latest
